    "papaparse": "^5.4.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "wouter": "^3.3.5",
